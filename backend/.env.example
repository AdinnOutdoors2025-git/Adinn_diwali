PORT=6000
# MongoDB connection string. Put the real value in backend/.env (gitignored) or the Render dashboard, never here.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
# Local alternative: mongodb://127.0.0.1:27017/adinn_diwali
# Required in production (the server refuses to start without it): at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-long-random-secret>
NODE_ENV=development
# Keep false. true starts a TEMPORARY database when MongoDB is unreachable (development only).
USE_MEMORY_DB_IF_LOCAL_FAILS=false
# Extra allowed CORS origins (comma-separated)
CORS_ORIGINS=https://adinn-diwali.vercel.app,https://adinn-diwali.onrender.com

# DigitalOcean Spaces (private bucket) for delivery-proof images. Real values go in backend/.env or the Render dashboard.
# DO_SPACES_ENDPOINT is the regional endpoint, e.g. https://blr1.digitaloceanspaces.com (not the bucket-prefixed URL).
# DO_SPACES_CDN_BASE is not used: proofs are never served from the CDN/public URL, only through the authenticated API.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
