PORT=6000
# Local MongoDB (no authentication). With authentication use mongodb://USER:PASSWORD@127.0.0.1:27017/adinn_diwali?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/adinn_diwali
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Keep false. true starts a TEMPORARY database when MongoDB is unreachable (development only).
USE_MEMORY_DB_IF_LOCAL_FAILS=false
